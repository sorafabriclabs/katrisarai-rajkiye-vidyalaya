{
  "name": "katrisarai-site",
  "version": "0.0.0",
  "description": "Government Degree College, Katrisarai, Nalanda — the college website. Angular with SSR, bilingual Hindi/English, deployed to Cloudflare Pages.",
  "private": true,
  "packageManager": "npm@10.9.7",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:cf": "node tools/cloudflare.deployment.mjs --prepare-only",
    "deploy": "node tools/cloudflare.deployment.mjs",
    "preview": "npm run build:cf && wrangler pages dev",
    "serve:ssr": "npm run build && node dist/katrisarai-site/server/server.mjs",
    "test": "ng test",
    "icons": "node tools/icons.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.3",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "wrangler": "^4.120.0"
  }
}
