{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The Cloudflare Pages project this deploys into — not the Angular project
  // name, which is katrisarai-site.
  //
  // It must match the project that actually exists in the account, or
  // `wrangler pages deploy` either fails with project-not-found or silently
  // creates a second project that no domain points at. `wrangler pages project
  // list` is the authority.
  "name": "katrisarai-rajkiye-vidyalaya-site",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // The directory `wrangler pages deploy` uploads, and the same value that goes
  // in the Cloudflare dashboard's "Build output directory" field.
  //
  // It is the *restructured* output: static files at the root, the SSR bundle
  // under server/, and a generated _worker.js beside them. Point Cloudflare at
  // the raw Angular output instead and there is no _worker.js, so the site
  // serves as static files — no SSR, no edge cache, and no 404s.
  //
  // A sibling of dist/katrisarai-site, never a child: `ng build` wipes its own
  // outputPath and would delete a nested directory, including one already
  // prepared for deploy.
  //
  // `main` and `assets` are deliberately absent. Those are Workers Static
  // Assets fields; under Pages they are not read at deploy time and their
  // relative paths break `wrangler pages dev` when run from the repo root.
  "pages_build_output_dir": "dist/katrisarai-site-cloudflare",
  // The notice board. `database_id` is filled in by
  // `wrangler d1 create katrisarai-notices` and is not a secret — it names the
  // database, it does not grant access to it.
  //
  // One binding, named `DB`, which is what `ApiEnv` and `server.cloudflare.ts`
  // read. `wrangler d1 create` appends a second binding of its own on the way
  // out; it was removed. Two bindings onto one database is legal and is a trap
  // — the code uses one of them, so the other silently stops being exercised
  // and nobody notices when it drifts.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "katrisarai-notices",
      "database_id": "21b81741-c202-4768-9bab-e46e48544558",
      "migrations_dir": "migrations",
    },
  ],
  // Uploaded files: the banner photograph and notice attachments. Served by
  // the Worker at /media/<key>, never directly from the bucket — the bucket
  // stays private, and `serveMedia` is what decides the headers.
  // Likewise one binding, `MEDIA`. `wrangler r2 bucket create` added a second.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "katrisarai-media",
    },
  ],
  // Cloudflare Access. Neither is a secret: the team domain is public, and the
  // AUD tag identifies the application rather than authorising anything.
  //
  // The team domain is where Access publishes the public keys this Worker
  // verifies tokens against. The AUD identifies the one application whose
  // tokens are accepted — without that check, a token minted for any other
  // Access application in the same team would be honoured here.
  //
  // Blank either of them and `verifyAccess` throws immediately, so every write
  // answers a 500 naming these two variables. It fails closed: a misconfigured
  // deployment cannot become an open admin area.
  //
  // The Access application covers `<host>/admin` and nothing else. Not
  // `/api/*`: Access matches on path rather than method, so that would also
  // sit in front of the public `GET /api/notices`. It is unnecessary anyway —
  // Access sets `CF_Authorization` for the whole domain, the admin page's
  // fetches carry it, and `verifyAccess` reads the cookie as well as the
  // header.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "frontend-q8r-pages.cloudflareaccess.com",
    "ACCESS_AUD": "94616a3c094a3852c6ee6b371070cd0f6dc5ed79f1b04d753b0664825e3e1bb1",
  },
}
