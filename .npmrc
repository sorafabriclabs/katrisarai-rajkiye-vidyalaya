# npm 10.9's dependency resolver crashes building the ideal tree for this set of
# packages — "Cannot read properties of null (reading 'edgesOut')", raised while
# walking jsdom's optional `canvas` peer, which nothing here uses. Strict peer
# resolution is what reaches that code path, and skipping it installs the same
# tree that `npm ci` then reproduces from the lockfile.
#
# Revisit when npm is next upgraded: if `npm install` succeeds with this line
# removed, remove it.
legacy-peer-deps=true
